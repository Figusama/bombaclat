# Ключ для жюри/клиентов (заголовок X-API-Key)
API_KEY=change-me
# Модель VLM (mlx-community/*-4bit); бэкенд: mlx (Apple Silicon) | hf (CUDA/transformers)
MODEL_ID=mlx-community/Qwen3.5-9B-4bit
VLM_BACKEND=mlx
PORT=8000
# Параметры анализа
SEG_LEN=8
FRAMES_PER_SEG=4
FRAME_W=416
MAX_SEGS=16
MIN_CONF=0.5
